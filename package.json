{
  "name": "s3d-catalogo",
  "version": "1.0.0",
  "private": true,
  "description": "Catálogo S3D: sitio estático (GitHub Pages). Este package.json solo sirve para las pruebas y las herramientas de compilación.",
  "scripts": {
    "test": "node tests/run.cjs",
    "build:paginas": "python3 scripts/build_product_pages.py",
    "build:css": "tailwindcss -c tailwind.config.js -i tailwind.input.css -o tailwind.css --minify",
    "imagenes": "node scripts/optimize_images.cjs"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "sharp": "^0.34.0",
    "tailwindcss": "3.4.17"
  }
}
